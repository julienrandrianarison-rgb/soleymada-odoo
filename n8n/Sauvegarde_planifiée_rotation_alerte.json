      "parameters": {
        "jsCode": "// Récupère tous les éléments reçus par le nœud précédent\nconst items = $input.all();\n\nif (items.length === 0) {\n  return [];\n}\n\n// Nombre de jours (ex: 1 pour test, 30 pour production)\nconst days = 1;\nconst cutoffDate = Date.now() - (days * 24 * 60 * 60 * 1000);\n\n// Filtre uniquement les éléments dont modifyTime est plus ancien que `days` jours\nconst olderItems = items.filter((item) => {\n  const modifyDate = new Date(item.json.modifyTime);\n  return !isNaN(modifyDate.getTime()) && modifyDate.getTime() < cutoffDate;\n});\n\n// Si aucun élément ne correspond, retourne un tableau vide\nif (olderItems.length === 0) {\n  return [{json: {Path: \"\"}}];\n}\n\n// Retourne TOUS les enregistrements filtrés avec les champs demandés\nreturn olderItems.map((item) => ({\n  json: {\n    Path: item.json.path,\n    Name: item.json.name,\n    modifyTime: item.json.modifyTime,\n    Size: item.json.size\n  }\n}));"
      },
